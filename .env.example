# ============================================================
# MAIL CONFIGURATION
# Copy this file to .env and fill in your credentials
# ============================================================

# SMTP Host (e.g. smtp.gmail.com)
MAIL_HOST=smtp.gmail.com

# SMTP Port (587 for TLS, 465 for SSL)
MAIL_PORT=587

# Encryption: tls or ssl
MAIL_ENCRYPTION=tls

# Your email/SMTP username
MAIL_USERNAME=your_email@gmail.com

# App Password (Gmail: Account > Security > App Passwords)
MAIL_PASSWORD=your_app_password_here

# From address
MAIL_FROM=your_email@gmail.com

# From display name
MAIL_FROM_NAME=Rizqi Yumna Shafwan

# Where contact form messages will be delivered
MAIL_TO=rizqiyumnaaa@gmail.com
